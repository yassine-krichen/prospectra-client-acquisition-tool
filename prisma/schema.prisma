// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Industry {
  local_service
  saas
  ecommerce
  agency
  other
}

enum CompanySize {
  size_1_10     @map("1-10")
  size_11_50    @map("11-50")
  size_51_200   @map("51-200")
  size_201_plus @map("201+")
  unknown

  @@map("CompanySize")
}

enum ProspectSource {
  google_places
  builtwith
  product_hunt
  crunchbase
  github
  indiehackers
  manual
  overpass
  yellowpages
  companies_house
  texas_comptroller
}

enum SignalType {
  outdated_site
  no_https
  old_stack
  new_launch
  funding_event
  hiring_post
  no_website
  technical_debt
  recently_registered
}

enum SignalStrength {
  weak
  medium
  strong
}

enum ProjectFit {
  landing_page
  full_stack_app
  backend_api
  unclear
}

enum EstimatedBudget {
  low
  mid
  high
  unknown
}

enum ProspectStatus {
  new
  enriched
  drafted
  queued
  sent
  followup_1
  followup_2
  followup_3
  replied
  won
  dead
  unsubscribed
}

enum ReplySentiment {
  positive
  neutral
  negative
}

enum ModelUsed {
  gemini
  groq
  deepseek
  claude_bridge @map("claude-bridge")
}

enum ServiceType {
  landing_page
  full_stack_app
  linkedin_media_management
  infra_hosting_retainer
}

enum JobCadence {
  one_off
  recurring
}

enum JobStatus {
  active
  delivered
  monthly
  cancelled
}

enum RetainerDiscount {
  free
  half_price
}

model Prospect {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyName String
  domain      String?
  websiteUrl  String?
  industry    Industry

  // Nested { city, country, lat, lng } — no query pattern needs it normalized.
  location Json

  companySize CompanySize

  // Discovery-time contact fields (e.g. scraped straight off a yellowpages
  // listing) - distinct from `contactName`/`contactTitle`/`contactEmail`
  // below, which are populated later by enrichment. Also used as secondary
  // dedupe keys in discovery.service.ts's `dedupeProspects`/`persistProspect`
  // for prospects with no domain.
  phone   String?
  address String?

  contactName     String?
  contactTitle    String?
  contactEmail    String?
  emailVerified   Boolean @default(false)
  // 0-100 int, not a 0-1 float. Not in the original spec's type but a
  // reasonable concretization to avoid float-precision surprises.
  emailConfidence Int
  linkedinUrl     String?

  source       ProspectSource
  sourceUrl    String
  discoveredAt DateTime

  // Nested { type, description, evidence, strength } — no query pattern
  // needs it normalized.
  signal Json

  projectFit      ProjectFit
  estimatedBudget EstimatedBudget
  priorityScore   Int

  // How many independent discovery sources have found this same business,
  // across all runs - monotonic, never decremented/reset (see
  // `dedupeProspects`/`persistProspect` in discovery.service.ts). Starts at
  // 1 (the source that first discovered it counts as one corroborating
  // source). Feeds `priority-scoring.ts`'s corroboration bonus - more
  // independent sources finding the same business is stronger evidence it's
  // real and active.
  corroboratingSourceCount Int @default(1)

  status        ProspectStatus @default(new)
  // Array of { status, timestamp } — no query pattern needs it normalized.
  statusHistory Json           @default("[]")

  // Dead-letter tracking for the most recent failed `draftProspect` attempt
  // (flagged/failure path) - { flagged, message, occurredAt }. Cleared back
  // to null on the next successful draft for this prospect. Nullable: most
  // prospects never fail drafting at all.
  lastDraftFailure Json?

  // Dashboard-only read marker, toggled by the user from the prospects table
  // (`PATCH /api/prospects/[id]/seen`). Purely a "don't make me re-scan
  // stuff I've already reviewed" UX aid — has no bearing on the outreach
  // pipeline itself (unlike `status`, nothing reads this to decide whether
  // to enrich/draft/send).
  seen Boolean @default(false)

  drafts         Draft[]
  activeDraftId  String?
  sentAt         DateTime?
  lastFollowupAt DateTime?
  followupCount  Int       @default(0)

  repliedAt      DateTime?
  replySentiment ReplySentiment?

  doNotContact   Boolean   @default(false)
  unsubscribedAt DateTime?

  notes String?
  tags  String[]

  // Nullable+unique: a Client can also be created directly (no forced
  // synthetic Prospect), and not every Prospect converts. The FK itself
  // lives on `Client.prospectId` — this is the back-relation only.
  client Client?

  // Array of { service, role: 'primary'|'cross_sell', priceRangeCents:
  // {min,max}|null, requiresManualQuote, reasoning, source: 'rules' } — no
  // query pattern needs it normalized. `source` is a deliberate seam for a
  // future optional LLM-suggestion overlay on top of the rules engine, not
  // built now.
  suggestedServices Json @default("[]")
}

model Draft {
  id            String    @id @default(cuid())
  prospect      Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId    String
  variant       Int
  subject       String
  body          String
  humanizedBody String?
  modelUsed     ModelUsed
  // Which copywriting framework (prompt-templates.ts's `FrameworkId`, e.g.
  // "pas") generated this variant. Plain nullable string, deliberately NOT a
  // Prisma enum: an enum would require a migration every time a framework is
  // added or retired, working against the framework registry's whole point
  // of easy iteration. Nullable so existing rows from before this column
  // existed remain valid without a backfill.
  framework     String?
  generatedAt   DateTime  @default(now())
  edited        Boolean   @default(false)
  approved      Boolean   @default(false)

  // Dead-letter tracking for the most recent failed Resend send attempt for
  // this draft - { reason, occurredAt }. Cleared back to null on the next
  // successful send of this same draft. Nullable: most drafts never fail to
  // send at all.
  lastSendFailure Json?

  @@index([prospectId])
}

// One row per discovery run (see `runDiscovery` in discovery.service.ts) - not
// a per-prospect audit trail, just the search inputs plus outcome counts, so
// the dashboard can show "you already searched this" instead of the operator
// blindly re-running an identical category+geography+branch search.
// `branch` is deliberately a plain String (not a Prisma enum), matching
// `Draft.framework`'s rationale: `DiscoveryBranch` is a Zod union
// ('a' | 'b' | 'both') in discovery.types.ts, not a Prisma enum, so mirroring
// it as a Prisma enum here would force a migration every time that union
// changes for reasons unrelated to this table.
model DiscoveryRun {
  id                  String   @id @default(cuid())
  category            String
  geography           String
  branch              String
  totalFound          Int
  inserted            Int
  updated             Int
  skippedDoNotContact Int
  sources             Json
  createdAt           DateTime @default(now())

  @@index([category, geography])
}

// Tracks calls made against a hard external free-tier quota (e.g. Hunter.io's
// per-account search cap - see MONTHLY_FREE_TIER_CAP in hunter.source.ts)
// so enrichment can refuse a call once the monthly cap is reached, rather
// than burning the quota on calls that fail anyway.
// `yearMonth` is a "YYYY-MM" string in UTC; a new row is created each month.
model ApiUsageCounter {
  id        String @id @default(cuid())
  source    String
  yearMonth String
  count     Int    @default(0)

  @@unique([source, yearMonth])
}

// Shared cooldown record for the claude-web-bridge sibling app: whenever ANY
// bridge call (the existing humanize() pass or Phase C's tier-2 draft
// generation) gets a 429, `bridge-budget.ts` upserts `blockedUntil` here so
// every future caller — across separate serverless invocations, which don't
// share in-memory state — cheaply knows the bridge is still rate-limited
// without independently rediscovering it.
model BridgeCooldown {
  source       String    @id
  blockedUntil DateTime?
}

// The post-sale relationship, created once a Prospect converts (or created
// directly, with no Prospect at all). Fields below are a denormalized COPY
// of the relevant Prospect fields at conversion time, not a live join —
// Client's lifecycle (jobs, retention) is deliberately separate from
// Prospect's outreach-era fields, and a Client must remain intact/queryable
// even if the source Prospect is later edited or deleted.
model Client {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prospect   Prospect? @relation(fields: [prospectId], references: [id])
  prospectId String?   @unique

  companyName  String
  domain       String?
  contactName  String?
  contactTitle String?
  contactEmail String?

  industry    Industry
  companySize CompanySize

  // Mirrors Prospect.doNotContact — retention (Phase 8) runs indefinitely
  // with no natural stop, so this is the one guard that halts it.
  doNotContact Boolean @default(false)

  notes String?
  // Array of { status, timestamp } — no query pattern needs it normalized.
  statusHistory Json @default("[]")

  jobs Job[]
}

// A single sold service against a Client. `agreedPriceCents` (cents, not
// float) is the actual negotiated price, independent of the catalog range
// it was quoted from (service-catalog.ts).
model Job {
  id String @id @default(cuid())

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  service  ServiceType
  cadence  JobCadence
  status   JobStatus   @default(active)

  agreedPriceCents Int

  soldAt      DateTime  @default(now())
  deliveredAt DateTime?

  // Catalog's "2 free fixes within 30 days of delivery" guarantee.
  freeRevisionRoundsUsed   Int       @default(0)
  freeRevisionWindowEndsAt DateTime?

  // Catalog's "3 months free/half-price hosting" lock-in on `infra_hosting_retainer`.
  retainerDiscount       RetainerDiscount?
  retainerDiscountEndsAt DateTime?

  // Phase 8 retention-scheduler state — same shape as Prospect's follow-up
  // counters (lastFollowupAt/followupCount).
  lastRetentionTouchAt DateTime?
  retentionTouchCount  Int       @default(0)

  // Array of { status, timestamp } — no query pattern needs it normalized.
  statusHistory Json    @default("[]")
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
}

// Fixed two-account auth (replaces the single shared DASHBOARD_PASSWORD env
// var). Nicknames are pre-provisioned (see app/api/cron/seed-users/route.ts)
// - there is no public registration endpoint, `nickname` is only ever one of
// the two values in src/features/auth/known-usernames.ts. `passwordHash` is
// null until that account's first login, at which point the submitted
// password becomes permanent (min 8 chars, enforced in the login route, not
// here - Prisma has no length-validation concept for a nullable String).
model User {
  id           String  @id @default(cuid())
  nickname     String  @unique
  passwordHash String?

  createdAt DateTime @default(now())

  // Captured once, on the login call that sets passwordHash for the first
  // time - the very first successful sign-in for this account.
  firstLoginAt        DateTime?
  firstLoginIp        String?
  firstLoginUserAgent String?
  firstLoginDevice    String?
  firstLoginBrowser   String?

  // Overwritten on every successful login thereafter (including the first).
  lastLoginAt        DateTime?
  lastLoginIp        String?
  lastLoginUserAgent String?
  lastLoginDevice    String?
  lastLoginBrowser   String?
}
