# Postgres connection string. Hosted on Neon (https://neon.tech) - create a
# project there and paste its connection string here. Get one free at
# neon.tech if you don't have one yet. Used for both the app and the test
# suite (a handful of test files hit this database for real and write/delete
# rows - see vitest.setup.ts - so don't point this at a database holding data
# you care about). Those test files now refuse to run at all unless
# CONFIRM_DESTRUCTIVE_TESTS=true is set - see src/common/testing/
# require-destructive-test-guard.ts.
DATABASE_URL="postgresql://<user>:<password>@<host>/biz_scraper?uselibpqcompat=true&sslmode=require"

# Shared password gating access to the dashboard (Phase 0 placeholder auth).
DASHBOARD_PASSWORD=""

# Secret used to sign the dashboard session cookie. Use a long random string.
SESSION_SECRET=""

# Google Places API key, used by the discovery source that searches by
# category + geography. Optional: not yet provisioned. Discovery reports this
# source as unavailable/skipped when unset, rather than failing the run.
GOOGLE_PLACES_API_KEY=""

# BuiltWith Domain API key, used to enrich discovered domains with tech-stack
# staleness signals. Optional: not yet provisioned. Same graceful skip as
# GOOGLE_PLACES_API_KEY above.
BUILTWITH_API_KEY=""

# Product Hunt GraphQL API token, used by the Branch B source that finds
# recently launched SaaS/startup products. Optional: not yet provisioned.
# Same graceful skip as GOOGLE_PLACES_API_KEY above.
PRODUCT_HUNT_API_TOKEN=""

# Crunchbase v4 API key, used by the Branch B source that finds recently
# funded startups. Optional: not yet provisioned. Same graceful skip.
CRUNCHBASE_API_KEY=""

# GitHub personal access token, used by the Branch B source that scans repos
# for hiring signals / CI-and-test gaps. Optional - unlike the keys above,
# GitHub's API still works unauthenticated at a much lower rate limit, so
# this isn't required for the source to run at all.
GITHUB_TOKEN=""

# Hunter.io API key, used by Branch C contact enrichment (email finding).
# Optional: not yet provisioned. Free tier is capped at 25 searches/month -
# enrichment.service.ts tracks usage via the ApiUsageCounter table and
# refuses to call Hunter past that cap.
HUNTER_API_KEY=""

# People Data Labs API key, used as a Branch C enrichment fallback when
# Hunter is unavailable or exhausted. Optional: not yet provisioned.
PEOPLE_DATA_LABS_API_KEY=""

# Google Gemini API key, used by Stage 2 drafting (model-rotation.ts).
# Optional: not yet provisioned - drafting reports Gemini unavailable and
# fails over to Groq when unset. Accepts a comma-separated list of keys for
# simple round-robin key rotation.
GEMINI_API_KEY=""

# Groq API key, another of the Stage 2 drafting rotation providers. Same
# optional/comma-separated-list pattern as GEMINI_API_KEY above.
GROQ_API_KEY=""

# DeepSeek API key, another of the Stage 2 drafting rotation providers. Same
# optional/comma-separated-list pattern as GEMINI_API_KEY above.
DEEPSEEK_API_KEY=""

# Base URL of the local claude-web-bridge sibling app used for the Stage 2
# humanizer pass. Optional - defaults to http://127.0.0.1:3000 in code when
# unset; only needs setting for a non-local bridge deployment.
CLAUDE_BRIDGE_URL=""

# Bearer token for the claude-web-bridge's own optional API_KEY auth.
# Optional - a local dev bridge instance may not have one configured.
CLAUDE_BRIDGE_API_KEY=""

# Shared secret required in the `x-cron-secret` header to trigger the
# discovery cron route. Required - use a long random string.
CRON_SECRET=""

# Resend API key, used by the Stage 3 send queue to actually deliver
# approved emails. Optional: no Resend account is provisioned yet - sends
# degrade to a typed failure rather than crashing when unset.
RESEND_API_KEY=""

# Domain outbound emails are sent from (from address is
# outreach@$SENDING_DOMAIN). Optional: no sending domain is owned yet.
SENDING_DOMAIN=""

# Set to the exact string "true" only once SPF/DKIM/DMARC are actually
# verified on SENDING_DOMAIN. THE hard gate on real send volume - see
# domain-verification-gate.ts. Defaults closed (false) if unset, empty, or
# anything other than exactly "true". Do not flip this until DNS is
# genuinely verified.
DOMAIN_DNS_VERIFIED=""

# Daily send cap enforced ONLY while DOMAIN_DNS_VERIFIED is not "true".
# Small on purpose. Defaults to 3 if unset.
DAILY_SEND_CAP_TEST="3"

# ISO date string (e.g. "2026-08-01") marking when domain warmup began.
# Optional - feeds daily-cap.ts's warmup ramp schedule, which only ever
# takes effect once DOMAIN_DNS_VERIFIED is "true". Unset/malformed is
# treated as "warmup hasn't started".
DOMAIN_WARMUP_START_DATE=""

# Signing secret for Resend's inbound webhook (app/api/webhooks/resend), in
# Resend/Svix's `whsec_<base64>` format. Optional: no webhook is provisioned
# yet. Unlike the other optional keys above, leaving this unset does NOT
# make the webhook route "run unauthenticated" - it makes the route refuse
# every incoming event outright (fail closed), since an unverified webhook
# would let anyone forge a "prospect replied" event.
RESEND_WEBHOOK_SECRET=""

# Hourly rate for work beyond a Job's bundled free-revision scope, and for
# estimating manual-quote services (pricing/hourly-rate.ts's
# getHourlyRateCents) where the fixed catalog has no price range at all
# (e.g. the 201+ company-size tier). Optional - defaults to 5000 ($50.00)
# if unset; override once a real rate is set.
HOURLY_RATE_CENTS=""

# Neon Management API key (console.neon.tech/api/v2) - a separate credential
# from DATABASE_URL, generated at console.neon.tech under Account Settings >
# API Keys. Used only to show real storage/compute/data-transfer usage in
# the System Health panel. Optional: without it (and NEON_PROJECT_ID below),
# that panel shows "NO DATA" for these rather than a guessed number.
NEON_API_KEY=""

# The Neon project id this app's database lives in (not discoverable from
# DATABASE_URL alone) - find it at console.neon.tech, Project Settings >
# General, or via GET /api/v2/projects with NEON_API_KEY. Optional, but
# required together with NEON_API_KEY for the usage feature above to
# activate.
NEON_PROJECT_ID=""
